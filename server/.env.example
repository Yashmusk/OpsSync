# Copy this file to .env and fill in your own values
MONGO_URI=mongodb://localhost:27017/OpsSync
PORT=5000

# Signs login tokens — use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AI assistant (Google Gemini) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.5-flash-lite
